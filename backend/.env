# backend/.env
PORT=3001
FRONTEND_URL=http://localhost:5173 # Ajusta si tu frontend corre en otro puerto (Vite suele usar 5173)

# Variables de conexión a PostgreSQL
DB_USER=admin_panaderia
DB_PASSWORD=password_seguro # La contraseña que pusiste en docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=panaderia_dev_db

# URL de conexión completa (opcional, la construiremos en el código si es necesario, o puedes usar esta)
# DATABASE_URL="postgresql://admin_panaderia:password_seguro@localhost:5432/panaderia_dev_db"